<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SternbildMapper">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|locale|layoutDirection"
            android:exported="true"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".solve.SolveForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Haelt Prozess/Netz waehrend eines Index-Katalog-Downloads (Einstellungen -> Index-Kataloge)
             bei gesperrtem Bildschirm am Leben, analog SolveForegroundService oben. -->
        <service
            android:name=".processing.IndexDownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Laeuft in EIGENEM Prozess: fuehrt EINEN nativen astrometry.net-Solve aus und beendet
             sich dann. astrometry.net ist nicht wiederverwendbar (2. Aufruf im selben Prozess ->
             exit(255), belegt via ApplicationExitInfo) -> frischer Prozess je Solve + Crash-Isolation
             (nur dieser Hilfsprozess stirbt, die App bleibt offen). -->
        <service
            android:name=".processing.LocalSolveService"
            android:exported="false"
            android:process=":solver" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
